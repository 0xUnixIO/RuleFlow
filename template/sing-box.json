{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "dns": {
    "reverse_mapping": true,
    "servers": [
      {
        "type": "local",
        "tag": "dns_local"
      },
      {
        "type": "udp",
        "tag": "dns_direct",
        "server": "223.5.5.5",
        "server_port": 53
      },
      {
        "type": "https",
        "tag": "dns_proxy",
        "server": "cloudflare-dns.com",
        "path": "/dns-query",
        "domain_resolver": "dns_direct",
        "detour": "🌐 Proxy"
      }
    ],
    "rules": [
      {
        "rule_set": [
          "apple_cdn",
          "apple_services",
          "apple_cn_non_ip",
          "microsoft_cdn_non_ip",
          "microsoft_non_ip",
          "download_domainset",
          "download_non_ip",
          "lan_non_ip",
          "domestic_non_ip",
          "direct_non_ip"
        ],
        "server": "dns_direct"
      },
      {
        "rule_set": [
          "stream_non_ip",
          "ai_non_ip",
          "non_ip_ai",
          "ai_ai",
          "telegram_non_ip",
          "cdn_domainset",
          "cdn_non_ip",
          "global_non_ip"
        ],
        "server": "dns_proxy"
      }
    ],
    "final": "dns_proxy",
    "strategy": "prefer_ipv4"
  },
  "endpoints": "__ENDPOINTS__",
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "interface_name": "tun0",
      "address": ["172.19.0.1/30"],
      "auto_route": true,
      "strict_route": true,
      "stack": "system"
    }
  ],
  "outbounds": [
    {
      "type": "selector",
      "tag": "🌐 Proxy",
      "outbounds": [
        "🛰 Auto",
        "🤖 AI",
        "🇭🇰 HK",
        "🇺🇸 US",
        "🇯🇵 JP",
        "DIRECT",
        "__NODES__"
      ],
      "default": "🛰 Auto"
    },
    {
      "type": "urltest",
      "tag": "🛰 Auto",
      "outbounds": ["__NODES__"],
      "url": "http://cp.cloudflare.com/generate_204",
      "interval": "5m",
      "tolerance": 50
    },
    {
      "type": "urltest",
      "tag": "🇭🇰 HK",
      "outbounds": ["__NODES__"],
      "filter": "🇭🇰",
      "url": "http://cp.cloudflare.com/generate_204",
      "interval": "5m",
      "tolerance": 50
    },
    {
      "type": "urltest",
      "tag": "🇺🇸 US",
      "outbounds": ["__NODES__"],
      "filter": "🇺🇸",
      "url": "http://cp.cloudflare.com/generate_204",
      "interval": "5m",
      "tolerance": 50
    },
    {
      "type": "urltest",
      "tag": "🇯🇵 JP",
      "filter": "🇯🇵",
      "outbounds": ["__NODES__"],
      "url": "http://cp.cloudflare.com/generate_204",
      "interval": "5m",
      "tolerance": 50
    },
    {
      "type": "selector",
      "tag": "🎬 Stream",
      "outbounds": ["🇯🇵 JP", "🇭🇰 HK"],
      "default": "🇭🇰 HK"
    },
    {
      "type": "selector",
      "tag": "🤖 AI",
      "filter": "(?i)HAWAII|AT&T",
      "outbounds": ["__NODES__"],
      "interrupt_exist_connections": true
    },
    "__OUTBOUNDS__",
    {
      "type": "direct",
      "tag": "DIRECT"
    },
    {
      "type": "block",
      "tag": "REJECT"
    }
  ],
